{
  "name": "@magimail/core",
  "version": "0.0.0",
  "description": "Shared core engine for Magimail and Mac Google apps suite",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.mjs",
      "require": "./dist/logger.js"
    },
    "./ui-strings": {
      "types": "./dist/ui-strings.d.ts",
      "import": "./dist/ui-strings.mjs",
      "require": "./dist/ui-strings.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.mjs",
      "require": "./dist/diagnostics.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "electron": ">=30.0.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "zod": "^4.6.7"
  }
}
