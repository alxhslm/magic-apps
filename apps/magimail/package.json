{
  "name": "magimail",
  "version": "0.0.0",
  "private": true,
  "description": "Magimail - Native macOS Desktop Client for Gmail",
  "license": "MPL-2.0",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"electron .\"",
    "dev:demo": "tsup --watch --onSuccess \"electron . --demo\"",
    "build": "tsup",
    "build:swift": "cd swift && ./build.sh release",
    "build:native": "cd native && swift build -c release && npx node-gyp rebuild",
    "build:share": "cd share-extension && ./build.sh debug && ./build.sh release",
    "build:intents": "cd app-intents-extension && ./build.sh debug && ./build.sh release",
    "build:all": "pnpm build && pnpm build:swift && pnpm build:native && pnpm build:share && pnpm build:widgets && pnpm build:intents",
    "typecheck": "tsc --noEmit",
    "test": "install-electron && vitest run",
    "start": "electron .",
    "app": "./scripts/build-app.sh",
    "app:install": "./scripts/build-app.sh --install",
    "app:install:fast": "./scripts/build-app.sh --install --fast",
    "package:dir": "pnpm build && electron-builder --mac --dir",
    "package:dmg": "pnpm build && electron-builder --mac dmg",
    "build:widgets": "cd widgets && ./build.sh release",
    "debug": "./scripts/debug-app.sh",
    "dump:css": "node scripts/dump-gmail-css.mjs",
    "cdp": "node ../../tools/cdp-eval.mjs",
    "release": "./scripts/release.sh",
    "test:native": "node scripts/test-native-notifications.mjs",
    "test:focus-filter": "node ../../tools/test-focus-filter-appcontext.mjs magimail"
  },
  "dependencies": {
    "@magimail/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
