---
import Default from '@astrojs/starlight/components/Footer.astro';
import site from '../data/site.json';
---

<Default {...Astro.props}><slot /></Default>

<footer class="docs-footer" aria-label="Suite footer">
  <div class="docs-footer__inner">
    <div class="docs-footer__links">
      <a href="/">Home</a>
      <a href="/magimail.html">Magimail</a>
      <a href="/magical.html">Magical</a>
      <a href="/#notify">v1.0 Waitlist</a>
      <a href="/privacy.html">Privacy</a>
      <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub &#8599;</a>
    </div>
    <p class="docs-footer__legal">
      &copy; {site.year} <a href={site.blogUrl} target="_blank" rel="noopener noreferrer">{site.author}</a>. All rights reserved. <Fragment set:html={site.trademark} />
    </p>
  </div>
</footer>

<style>
  .docs-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .docs-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .docs-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .docs-footer__links a {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .docs-footer__links a:hover {
    color: var(--sl-color-white);
  }

  .docs-footer__legal {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-4);
    margin: 0;
    line-height: 1.5;
  }
</style>
