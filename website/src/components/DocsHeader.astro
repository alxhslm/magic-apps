---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import site from '../data/site.json';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a class="brand" href="/">
      <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true">
        <rect width="24" height="24" rx="7" fill="#1E1B4B"></rect>
        <path
          d="M12 4.6 Q12 12 19.4 12 Q12 12 12 19.4 Q12 12 4.6 12 Q12 12 12 4.6 Z"
          fill="#F5C24C"
        ></path>
      </svg>
      <span>{site.name}</span>
    </a>
  </div>

  <nav class="sl-hidden md:sl-flex docs-nav-links" aria-label="Main site pages">
    <a href="/magimail.html">Magimail</a>
    <a href="/magical.html">Magical</a>
    <a href="/help/" aria-current="page">Help</a>
  </nav>

  <div class="sl-flex search-wrapper print:hidden">
    {shouldRenderSearch && <Search />}
  </div>

  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: 1.5rem;
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      overflow: clip;
      min-width: 0;
      flex: none;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--sl-color-text);
      font-family: var(--sl-font);
      font-weight: 600;
      font-size: 1.0625rem;
      letter-spacing: -0.015em;
      text-decoration: none;
    }

    .brand:hover {
      color: var(--sl-color-text);
    }

    .brand__mark {
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 8px;
      flex: none;
    }

    .docs-nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .docs-nav-links a {
      color: var(--sl-color-gray-3);
      font-size: 0.9375rem;
      font-weight: 500;
      text-decoration: none;
      transition: color 0.15s ease;
      white-space: nowrap;
    }

    .docs-nav-links a:hover {
      color: var(--sl-color-text);
    }

    .docs-nav-links a[aria-current='page'] {
      color: var(--sl-color-text);
      font-weight: 600;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }
    .social-icons::after {
      content: '';
      height: 1.5rem;
      border-inline-end: 1px solid var(--sl-color-hairline);
    }

    @media (min-width: 50rem) {
      .header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .search-wrapper {
        flex: 1;
        max-width: 22rem;
        margin-inline-start: auto;
      }
    }
  }
</style>
