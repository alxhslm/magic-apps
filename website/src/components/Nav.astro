---
import site from '../data/site.json';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<!-- ============================================================ nav -->
<header class="nav">
  <div class="wrap nav__inner">
    <a class="brand" href="/">
      <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true">
        <rect width="24" height="24" rx="7" fill="#1E1B4B"></rect>
        <path
          d="M12 4.6 Q12 12 19.4 12 Q12 12 12 19.4 Q12 12 4.6 12 Q12 12 12 4.6 Z"
          fill="#F5C24C"
        ></path>
      </svg>
      <span>{site.name}</span>
    </a>
    <nav class="nav__links" aria-label="Pages">
      <a href="/magimail.html" aria-current={current === 'magimail' ? 'page' : undefined}>Magimail</a>
      <a href="/magical.html" aria-current={current === 'magical' ? 'page' : undefined}>Magical</a>
      <a
        class="nav__icon-link"
        href={site.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
        title="GitHub repository"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          ></path>
        </svg>
      </a>
    </nav>
  </div>
</header>
