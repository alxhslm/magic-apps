---
import BaseLayout from '../layouts/BaseLayout.astro';
import Notify from '../components/Notify.astro';
import site from '../data/site.json';

const notify = {
  band: 'wrap band band--ruled',
  heading: 'Join the v1.0 waitlist',
  lead: "Download the Magical alpha today, or leave your email to find out when the first stable release is ready.",
};
---

<BaseLayout
  title="Magical | Google Calendar as a proper Mac app"
  description="Put a spell on your calendar. A proper Mac app for Google Calendar, from the makers of Magimail. Coming soon."
  ogDescription="Put a spell on your calendar. A proper Mac app for Google Calendar.  Coming soon."
  icon="magical.svg"
  current="magical"
  permalink="magical.html"
>
  <!-- ============================================================ hero -->
  <section class="wrap hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="chip rise">Open source</p>
        <h1 class="hero__title rise">Put a spell on your calendar.</h1>
        <p class="lead rise">
          Google Calendar is not an afterthought. Magical is built on the same
          foundations as Magimail, but with extra features to help you manage your day.
        </p>
        <div class="btn-row rise">
          <a class="btn btn--primary" href={site.downloads.magical.dmgUrl} target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            Download Magical (Alpha)
          </a>
          <a class="btn btn--ghost" href="#notify">Join v1.0 Waitlist</a>
        </div>
        <p class="hero__req small dim rise" set:html={site.requirementsShort} />
      </div>

      <div class="hero__art">
        <img
          src="assets/calendar-art.svg"
          width="384"
          height="424"
          alt="A flip-page desk calendar showing August 31, standing on its ring binders"
        />
      </div>
    </div>
  </section>

  <!-- ====================================================== up close -->
  <section class="band band--raised band--ruled" id="up-close" aria-labelledby="up-close-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="up-close-title">What makes it a Mac app</h2>
        <p class="lead">
          No more loading your browser just to quickly check when that meeting is. Magical
          gives you quick access to all your accounts, meetings and invitations.
        </p>
      </div>

      <!-- 1. accounts -->
      <article class="dive">
        <div class="dive__copy">
          <h3>Every account, properly isolated</h3>
          <p>
            Every account keeps its own sign-in. No signing out, no switching, no wondering which
            schedule you are looking at.
          </p>
          <ul class="notes">
            <li>
              Each account carries its own colour, on its tab, in the menu bar and on its
              notifications.
            </li>
            <li>Switch with <kbd>&#8984;1</kbd> and <kbd>&#8984;2</kbd>, or click its tab.</li>
            <li>
              Accounts in the background keep schedules in sync, so alerts and widgets stay accurate.
            </li>
            <li>
              Your desktop shows through the sidebar the way it does in Calendar and Finder, in
              light and dark alike.
            </li>
          </ul>
        </div>
        <div class="stage">
          <div class="themed">
            <div class="themed__pick" role="group" aria-label="Appearance">
              <input type="radio" name="win-theme" id="win-light" checked />
              <label for="win-light">Light</label>
              <input type="radio" name="win-theme" id="win-dark" />
              <label for="win-dark">Dark</label>
            </div>
            <img
              class="shot shot--framed shot--window themed__light"
              src="assets/shot-window-magical-light.webp"
              width="1280"
              height="820"
              alt="The Magical window in light mode, with Personal and Work tabs in the toolbar and a week calendar view below"
              loading="lazy"
            />
            <img
              class="shot shot--framed shot--window themed__dark"
              src="assets/shot-window-magical-dark.webp"
              width="1280"
              height="820"
              alt="The same window in dark mode"
              loading="lazy"
            />
          </div>
        </div>
      </article>

      <!-- 2. toolbar -->
      <article class="dive dive--flip">
        <div class="dive__copy">
          <h3>A toolbar you can rearrange</h3>
          <p>
            A real Mac toolbar, not a row of buttons drawn in a web page, so it behaves like
            every other one you use.
          </p>
          <ul class="notes">
            <li>
              Drag the buttons into whatever order suits you, from
              <em>View &rarr; Customise Toolbar&hellip;</em>
            </li>
            <li>
              Date navigation, the invitations tray, a new task button and a search field, each
              one yours to place or leave out.
            </li>
          </ul>
        </div>
        <div class="stage">
          <img
            class="shot shot--framed shot--window"
            src="assets/shot-toolbar-magical.webp"
            width="1200"
            height="662"
            alt="The Customise Toolbar sheet, with date navigation, invitations, task and search items ready to drag into place"
            loading="lazy"
          />
        </div>
      </article>

      <!-- 3. menu bar -->
      <article class="dive">
        <div class="dive__copy">
          <h3>A mini calendar in the menu bar</h3>
          <p>
            See what the rest of your day looks like, RSVP to invites, or jump straight to your
            next video call.
          </p>
          <ul class="notes">
            <li>Countdown to your next meeting directly in the menu bar.</li>
            <li>A red line marks where the day has got to.</li>
            <li>Every event takes the colour of the calendar it sits on.</li>
          </ul>
        </div>
        <div class="stage">
          <img
            class="shot shot--free"
            src="assets/shot-popover-magical.webp"
            width="392"
            height="724"
            alt="The Magical menu bar popover, showing a meeting under way, a month grid with a dot for each busy day, and the day's events either side of a red line marking the current time"
            loading="lazy"
          />
        </div>
      </article>

      <!-- 4. widgets -->
      <article class="dive dive--flip">
        <div class="dive__copy">
          <h3>And on the desktop too</h3>
          <p>
            Choice of 6 different widgets of varying sizes and layouts.
          </p>
          <ul class="notes">
            <li>Up next counts down to the next meeting.</li>
            <li>Agenda shows your day and what's coming tomorrow.</li>
            <li>Month gives you a full mini calendar</li>
          </ul>
        </div>
        <div class="stage">
          <img
            class="shot shot--free shot--widget"
            src="assets/shot-widgets-magical.webp"
            width="561"
            height="561"
            alt="Three Magical widgets on the desktop: a small Up next counting down to a meeting with a Join button, a medium Agenda listing the day, and a large Month showing the grid above today's events"
            loading="lazy"
          />
        </div>
      </article>

      <!-- 5. tasks -->
      <article class="dive">
        <div class="dive__copy">
          <h3>Your to-dos right next to your meetings</h3>
          <p>
            Google Tasks appear in the menu bar and the widgets, in the same list as your
            events.
          </p>
          <ul class="notes">
            <li>Mark one complete from the menu bar.</li>
            <li>Add one with the toolbar's task button, which opens Google's own task field.</li>
            <li>Choose whether completed tasks are shown at all.</li>
          </ul>
        </div>
        <div class="stage">
          <img
            class="shot shot--framed shot--window"
            src="assets/shot-tasks-magical.webp"
            width="392"
            height="352"
            alt="The agenda showing two open tasks with empty completion circles, a completed task greyed out, and a meeting below them"
            loading="lazy"
          />
        </div>
      </article>

      <!-- 6. dock -->
      <article class="dive dive--flip">
        <div class="dive__copy">
          <h3>Today's date on your dock</h3>
          <p>
            See today's date directly on the dock just like Apple calendar.
            
            The badge counts your unread invitations, so you have no excuse not to RSVP.
          </p>
        </div>
        <div class="stage">
          <img
            class="shot shot--free shot--dock"
            src="assets/shot-dock-magical.webp"
            width="760"
            height="222"
            alt="The Dock, with Magical displaying today's date on its calendar tile"
            loading="lazy"
          />
        </div>
      </article>

      <!-- 7. notifications -->
      <article class="dive">
        <div class="dive__copy">
          <h3>Never late for a call</h3>
          <p>
            Native alerts for both events and RSVPs, with quick actions.
          </p>
          <ul class="notes">
            <li>Join Google Meet, Zoom, or Teams calls directly from the banner with one click.</li>
            <li>RSVP to invitations right from the banner.</li>
          </ul>
        </div>
        <div class="stage">
          <img
            class="shot shot--framed shot--notification"
            src="assets/shot-notification-magical.webp"
            width="744"
            height="316"
            alt="A Magical meeting reminder notification banner with direct conference join options"
            loading="lazy"
          />
        </div>
      </article>

      <!-- 8. focus -->
      <article class="dive dive--flip">
        <div class="dive__copy">
          <h3>Work stays in work hours</h3>
          <p>
            Link Magical to macOS Focus filters to decide which accounts and calendars are
            visible.
          </p>
          <ul class="notes">
            <li>
              Silenced calendars are hidden everywhere including menubar and widgets.
            </li>
            <li>
              Keep an account and still turn off the calendars you don't need, one at a
              time.
            </li>
            <li>
              Choose whether silenced accounts remain reachable in the switcher or stay completely blocked until the Focus ends.
            </li>
          </ul>
        </div>
        <div class="stage">
          <img
            class="shot shot--framed shot--wide"
            src="assets/shot-focus-magical.webp"
            width="420"
            height="645"
            alt="The macOS Focus settings for Magical, keeping Personal and its Family and Birthdays calendars while Work stays silenced"
            loading="lazy"
          />
        </div>
      </article>
    </div>
  </section>

  <!-- ============================================================ premise -->
  <section class="wrap band band--ruled" aria-labelledby="premise-title">
    <div class="section-head">
      <h2 id="premise-title">The full Google Calendar experience</h2>
      <p class="lead">
        Magical supports every feature Google Calendar supports in the browser, and new features
        arrive the day Google ships them. All you do is sign in.
      </p>
    </div>

    <ul class="fidelity">
      <li><strong>Find a Time</strong> and room booking</li>
      <li>Working Locations and <strong>Focus Time</strong></li>
      <li>Out-of-office <strong>auto-declines</strong></li>
      <li>Secondary and <strong>shared calendars</strong></li>
      <li><strong>Workspace add-ons</strong> and marketplace apps</li>
      <li>Full <strong>Google Tasks</strong> support</li>
      <li>Google Calendar's own <strong>keyboard shortcuts</strong></li>
      <li><strong>Offline support</strong>, for planes and tunnels</li>
    </ul>
  </section>

  <!-- ============================================================ under the hood -->
  <section class="wrap band" aria-labelledby="hood-title">
    <div class="section-head">
      <h2 id="hood-title">No accounts to make, no servers in the middle</h2>
    </div>

    <dl class="specs">
      <div class="spec">
        <dt>Sign-in</dt>
        <dd>Your ordinary Google sign-in</dd>
      </div>
      <div class="spec">
        <dt>Source code</dt>
        <dd>Open source (MPL 2.0)</dd>
      </div>
      <div class="spec">
        <dt>Accounts at once</dt>
        <dd>As many as you like</dd>
      </div>
      <div class="spec">
        <dt>Analytics &amp; tracking</dt>
        <dd>None</dd>
      </div>
      <div class="spec">
        <dt>Our servers</dt>
        <dd>None</dd>
      </div>
      <div class="spec">
        <dt>Requires</dt>
        <dd>macOS 14 or later, Apple silicon</dd>
      </div>
    </dl>

    <p class="footnote">
      Events, invitations, and calendar sync come straight from Google to your Mac, using the
      sign-in you already have, so there's nothing to set up and no permissions screen to approve.
      The menu bar popover, desktop widgets, and notifications run separately from the calendar
      view, so they stay quick even with heavy multi-calendar setups. Nothing about your schedule
      goes anywhere except Google.
    </p>
  </section>

  <Notify notify={notify} />
</BaseLayout>
