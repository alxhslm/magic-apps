---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Magic Apps"
  description="The page you're looking for doesn't exist or has moved."
  ogDescription="Page not found."
  icon="suite.svg"
  current="404"
  permalink="404.html"
>
  <section class="wrap band" aria-labelledby="not-found-title">
    <div class="notify" style="margin-block: clamp(2rem, 5vw, 4rem);">
      <p class="chip">404</p>
      <h1 id="not-found-title">Page not found.</h1>
      <p class="lead">
        The page you're looking for doesn't exist or has moved.
      </p>
      <div class="btn-row" style="justify-content: center; width: 100%; margin-top: 0.5rem;">
        <a class="btn btn--primary" href="index.html">&larr; Back to overview</a>
      </div>
    </div>
  </section>
</BaseLayout>
